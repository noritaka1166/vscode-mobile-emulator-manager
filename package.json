{
  "name": "mobile-emulator-manager",
  "displayName": "Mobile Emulator Manager: iOS & Android",
  "description": "Launch, stop, and manage Android Emulators and iOS Simulators in VS Code. Install APK/IPA apps, quick-start devices, and copy ADB serials or UDIDs.",
  "publisher": "noritaka1166",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/noritaka1166/vscode-mobile-emulator-manager.git"
  },
  "bugs": {
    "url": "https://github.com/noritaka1166/vscode-mobile-emulator-manager/issues"
  },
  "homepage": "https://github.com/noritaka1166/vscode-mobile-emulator-manager#readme",
  "license": "MIT",
  "icon": "icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0B1242",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Mobile Emulator Manager runs local Android SDK and Xcode command-line tools to list, start, stop, and install apps on emulators."
    }
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "android",
    "android emulator",
    "android studio",
    "android sdk",
    "avd",
    "adb",
    "apk",
    "ios",
    "ios simulator",
    "xcode",
    "simctl",
    "ipa",
    "mobile",
    "mobile development",
    "emulator",
    "simulator",
    "device manager",
    "emulator manager",
    "flutter",
    "react native",
    "expo",
    "ionic",
    "capacitor",
    "cordova",
    "app testing",
    "mobile testing",
    "qa",
    "developer tools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Mobile Emulator Manager",
      "properties": {
        "mobileEmulatorManager.androidSdkPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Android SDK. When empty, the extension uses `ANDROID_SDK_ROOT`, `ANDROID_HOME`, or the platform default SDK location."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "emulator-manager",
          "title": "Emulators",
          "icon": "assets/emulators.svg"
        }
      ]
    },
    "views": {
      "emulator-manager": [
        {
          "id": "emulatorsView",
          "name": "Devices",
          "icon": "assets/emulators.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "emulators.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "emulators.start",
        "title": "Start",
        "icon": "$(debug-start)"
      },
      {
        "command": "emulators.quickStart",
        "title": "Mobile Emulator Manager: Start Device...",
        "icon": "$(play)"
      },
      {
        "command": "emulators.quickStartAndInstallApp",
        "title": "Mobile Emulator Manager: Start and Install App...",
        "icon": "$(run-all)"
      },
      {
        "command": "emulators.quickInstallLastApp",
        "title": "Mobile Emulator Manager: Install Last App...",
        "icon": "$(history)"
      },
      {
        "command": "emulators.stop",
        "title": "Stop",
        "icon": {
          "light": "assets/stop-red.svg",
          "dark": "assets/stop-red.svg"
        }
      },
      {
        "command": "emulators.installApp",
        "title": "Install App...",
        "icon": "$(package)"
      },
      {
        "command": "emulators.installLastApp",
        "title": "Install Last App",
        "icon": "$(history)"
      },
      {
        "command": "emulators.startAndInstallApp",
        "title": "Start and Install App...",
        "icon": "$(rocket)"
      },
      {
        "command": "emulators.copyId",
        "title": "Copy UDID"
      },
      {
        "command": "emulators.copyAndroidSerial",
        "title": "Copy ADB Serial"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "emulators.refresh",
          "when": "view == emulatorsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "emulators.start",
          "when": "view == emulatorsView && viewItem =~ /stopped$/",
          "group": "inline@1"
        },
        {
          "command": "emulators.startAndInstallApp",
          "when": "view == emulatorsView && viewItem =~ /stopped$/",
          "group": "inline@2"
        },
        {
          "command": "emulators.stop",
          "when": "view == emulatorsView && viewItem =~ /running$/",
          "group": "inline@1"
        },
        {
          "command": "emulators.installApp",
          "when": "view == emulatorsView && viewItem =~ /running$/",
          "group": "inline@2"
        },
        {
          "command": "emulators.installLastApp",
          "when": "view == emulatorsView && viewItem =~ /running$/",
          "group": "inline@3"
        },
        {
          "command": "emulators.copyId",
          "when": "view == emulatorsView && viewItem =~ /^emulator-ios-/"
        },
        {
          "command": "emulators.copyAndroidSerial",
          "when": "view == emulatorsView && viewItem == emulator-android-running"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node16",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "test": "npm run compile && node --test out/test/androidSdk.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24.13.1",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
