{
  "name": "mobile-emulator-manager",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "noritaka1166",
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/noritaka1166/vscode-mobile-emulator-manager.git"
  },
  "bugs": {
    "url": "https://github.com/noritaka1166/vscode-mobile-emulator-manager/issues"
  },
  "homepage": "https://github.com/noritaka1166/vscode-mobile-emulator-manager#readme",
  "license": "MIT",
  "icon": "icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0B1242",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "android",
    "android emulator",
    "android studio",
    "android sdk",
    "avd",
    "adb",
    "apk",
    "ios",
    "ios simulator",
    "xcode",
    "simctl",
    "ipa",
    "mobile",
    "mobile development",
    "emulator",
    "simulator",
    "device manager",
    "emulator manager",
    "flutter",
    "react native",
    "expo",
    "ionic",
    "capacitor",
    "cordova",
    "app testing",
    "mobile testing",
    "qa",
    "developer tools"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "mobileEmulatorManager.androidSdkPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.androidSdkPath.markdownDescription%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "emulator-manager",
          "title": "%viewsContainers.emulators.title%",
          "icon": "assets/emulators.svg"
        }
      ]
    },
    "views": {
      "emulator-manager": [
        {
          "id": "emulatorsView",
          "name": "%views.devices.name%",
          "icon": "assets/emulators.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "emulators.refresh",
        "title": "%commands.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "emulators.start",
        "title": "%commands.start.title%",
        "icon": "$(debug-start)"
      },
      {
        "command": "emulators.quickStart",
        "title": "%commands.quickStart.title%",
        "icon": "$(play)"
      },
      {
        "command": "emulators.quickStartAndInstallApp",
        "title": "%commands.quickStartAndInstallApp.title%",
        "icon": "$(run-all)"
      },
      {
        "command": "emulators.quickInstallLastApp",
        "title": "%commands.quickInstallLastApp.title%",
        "icon": "$(history)"
      },
      {
        "command": "emulators.stop",
        "title": "%commands.stop.title%",
        "icon": {
          "light": "assets/stop-red.svg",
          "dark": "assets/stop-red.svg"
        }
      },
      {
        "command": "emulators.installApp",
        "title": "%commands.installApp.title%",
        "icon": "$(package)"
      },
      {
        "command": "emulators.installLastApp",
        "title": "%commands.installLastApp.title%",
        "icon": "$(history)"
      },
      {
        "command": "emulators.startAndInstallApp",
        "title": "%commands.startAndInstallApp.title%",
        "icon": "$(rocket)"
      },
      {
        "command": "emulators.copyId",
        "title": "%commands.copyId.title%"
      },
      {
        "command": "emulators.copyAndroidSerial",
        "title": "%commands.copyAndroidSerial.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "emulators.refresh",
          "when": "view == emulatorsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "emulators.start",
          "when": "view == emulatorsView && viewItem =~ /stopped$/",
          "group": "inline@1"
        },
        {
          "command": "emulators.startAndInstallApp",
          "when": "view == emulatorsView && viewItem =~ /stopped$/",
          "group": "inline@2"
        },
        {
          "command": "emulators.stop",
          "when": "view == emulatorsView && viewItem =~ /running$/",
          "group": "inline@1"
        },
        {
          "command": "emulators.installApp",
          "when": "view == emulatorsView && viewItem =~ /running$/",
          "group": "inline@2"
        },
        {
          "command": "emulators.installLastApp",
          "when": "view == emulatorsView && viewItem =~ /running$/",
          "group": "inline@3"
        },
        {
          "command": "emulators.copyId",
          "when": "view == emulatorsView && viewItem =~ /^emulator-ios-/"
        },
        {
          "command": "emulators.copyAndroidSerial",
          "when": "view == emulatorsView && viewItem == emulator-android-running"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node16",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "test": "npm run compile && node --test out/test/androidSdk.test.js",
    "l10n:generate": "npx @vscode/l10n-dev export ./src --outDir ./l10n"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.13.1",
    "@types/vscode": "^1.80.0",
    "@vscode/l10n-dev": "^0.0.35",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
